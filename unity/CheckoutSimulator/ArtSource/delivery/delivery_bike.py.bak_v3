        sphere(f"strap_hook{s}", .009, (-0.75, s * .20, rz - .02), m["chrome"], seg=10)
    build_bau((-0.86, 0, rz + .016))
    lathe("tail", [(0, 0), (.055, 0), (.06, .02), (.05, .04), (0, .045)], (-1.00, 0, 0.66), m["black"], segs=40, rot=(0, rad(-90), 0), ss=2)
    lathe("tail_lens", [(0, .04), (.05, .04), (.042, .055), (0, .06)], (-1.00, 0, 0.66), m["tail"], segs=40, rot=(0, rad(-90), 0), ss=2)
    for k in range(3): torus(f"tail_rib{k}", .015 + k * .012, .001, (-1.052 - k * .003, 0, .66), m["tail"], rot=(0, rad(90), 0), segs=(32, 6))
    box("plate_bracket", (.02, .06, .10), (-1.00, 0, 0.58), m["gun"], bev=.004)
    box("plate", (.010, .20, .13), (-1.03, 0, 0.53), m["white"], bev=.003, seg=3)
    box("plate_rim", (.004, .20, .13), (-1.036, 0, 0.53), m["ink"], bev=.002, seg=2); box("plate_in", (.004, .18, .11), (-1.037, 0, 0.53), m["white"], bev=.002, seg=2)
    box("plate_band", (.004, .18, .022), (-1.0375, 0, 0.574), m["blue"], bev=.001)
    text("plate_txt", "CKT 2E26", .040, (-1.040, 0, 0.525), m["ink"], rot=(rad(90), 0, rad(-90)), extrude=.0015)
    text("plate_txt2", "BRASIL", .013, (-1.040, 0, 0.574), m["white"], rot=(rad(90), 0, rad(-90)), extrude=.001)
    for s in (-1, 1): cyl(f"plate_bolt{s}", .005, .006, (-1.040, s * .08, 0.58), m["chrome"], axis='X', verts=8)
    for s in (-1, 1):
        ip = Vector((-0.98, s * .23, 0.70))
        tube(f"blink_r_st{s}", (-0.94, s * .12, 0.76), ip, .007, m["black"], verts=10, cap=False)
        lathe(f"blink_r{s}", [(0, -.02), (.028, -.02), (.03, 0), (.03, .02), (.026, .03), (0, .03)], ip, m["black"], segs=32, rot=(0, rad(-90), 0), ss=2)
        lathe(f"blink_r_lens{s}", [(0, .03), (.025, .03), (.02, .045), (0, .05)], ip, m["amber"], segs=32, rot=(0, rad(-90), 0), ss=2)
        for k in range(4): torus(f"blink_r_rib{s}{k}", .010 + k * .004, .0008, ip + Vector((-.032 - k * .003, 0, 0)), m["amber"], rot=(0, rad(90), 0), segs=(32, 6))
    if parked:
        tube("kickstand", (-0.20, -.13, 0.32), (-0.08, -.30, 0.0), .010, m["black"])
        box("kick_foot", (.04, .05, .012), (-0.08, -.30, 0.006), m["black"], bev=.004)
        tube("kick_spring", (-0.18, -.15, 0.30), (-0.30, -.13, 0.33), .005, m["chrome"], verts=8)
        coil = [(0, 0)]
        for k in range(20): coil += [(.006, k * .004), (.004, k * .004 + .002)]
        lathe("kick_coil", coil + [(0, .08)], (-0.19, -.145, 0.31), m["spring"], segs=12, rot=Vector((-.12, .02, .03)).to_track_quat('Z', 'Y').to_euler())

# ---------------------------------------------------------------- bau
def bag_logo(nm, loc, rot, m_white, size=.17, m_handle=None):
    bpy.ops.object.empty_add(location=loc, rotation=rot); e = bpy.context.object; e.name = nm; e.parent = ROOT
    saved = globals()["ROOT"]; globals()["ROOT"] = e
    rbox(nm + "_body", (size, size * .80, .006), (0, -size * .10, 0), m_white, seg=4, ss=2)
    torus(nm + "_handle", size * .24, size * .035, (0, size * .30, 0), m_handle or m_white, segs=(40, 12))
    globals()["ROOT"] = saved
    return e

def qr_sticker(nm, loc, rot, m_white, m_ink, size=.06):
    """Printed sticker with a pseudo QR code (deterministic bit pattern)."""
    bpy.ops.object.empty_add(location=loc, rotation=rot); e = bpy.context.object; e.name = nm; e.parent = ROOT
    saved = globals()["ROOT"]; globals()["ROOT"] = e
    box(nm + "_bg", (size * 1.25, size * 1.25, .003), (0, 0, 0), m_white, bev=.004, seg=3)
    n = 11; c = size / n
    for i in range(n):
        for j in range(n):
            finder = (i < 3 and j < 3) or (i < 3 and j >= n - 3) or (i >= n - 3 and j < 3)
            bit = finder and (i in (0, 2) or j in (0, 2) or (i == 1 and j == 1) or (i == 1 and j == n - 2) or (i == n - 2 and j == 1)) or (not finder and ((i * 7 + j * 13 + (i * j) % 5) % 3 == 0))
            if finder and not (i in (0, 2, n - 3, n - 1) or j in (0, 2, n - 3, n - 1) or (i, j) in ((1, 1), (1, n - 2), (n - 2, 1))): bit = False
            if bit: box(f"{nm}_q{i}_{j}", (c * .95, c * .95, .002), ((i - n / 2 + .5) * c, (j - n / 2 + .5) * c, .0025), m_ink, bev=0)
    globals()["ROOT"] = saved
    return e

def build_bau(loc):
    m = M(); W, D, H = .46, .46, .42; x, y, z = loc
    box("bau_body", (W, D, H), (x, y, z + H / 2), m["blue"], bev=.045, seg=6, ss=3)
    box("bau_lid", (W + .02, D + .02, .07), (x, y, z + H + .035), m["blue_d"], bev=.03, seg=6, ss=3)
    box("bau_gasket", (W + .026, D + .026, .010), (x, y, z + H), m["ink"], bev=.004, seg=3)
    for k, yy in enumerate((y - .14, y + .14)):
        cyl(f"bau_hinge{k}", .012, .08, (x + W / 2 + .018, yy, z + H + .01), m["steel"], axis='Y', verts=20, bev=.002)
        box(f"bau_hinge_pl{k}", (.03, .05, .006), (x + W / 2 + .005, yy, z + H + .045), m["steel"], bev=.002)
        box(f"bau_hinge_pl{k}b", (.006, .05, .04), (x + W / 2 + .016, yy, z + H - .02), m["steel"], bev=.002)
        for s in (-1, 1): cyl(f"bau_hinge_riv{k}{s}", .004, .004, (x + W / 2 + .018, yy + s * .015, z + H + .049), m["chrome"], verts=8)
        box(f"bau_latch{k}", (.012, .05, .09), (x - W / 2 - .008, yy, z + H - .03), m["steel"], bev=.003, seg=3, ss=2)
        box(f"bau_latch_hook{k}", (.016, .03, .02), (x - W / 2 - .010, yy, z + H + .02), m["steel"], bev=.004)
        box(f"bau_latch_lever{k}", (.008, .036, .05), (x - W / 2 - .016, yy, z + H - .055), m["steel"], bev=.003, seg=3)
    rbox("bau_handle", (.11, .22, .03), (x, y, z + H + .085), m["black"], seg=4, ss=2)
    for s in (-1, 1): box(f"bau_handle_leg{s}", (.03, .02, .03), (x, y + s * .09, z + H + .075), m["black"], bev=.006)
    for sx in (-1, 1):   # rubber corner bumpers (bottom)
        for sy in (-1, 1): rbox(f"bau_bumper{sx}{sy}", (.07, .07, .05), (x + sx * (W / 2 - .025), y + sy * (D / 2 - .025), z + .02), m["black"], seg=4, ss=2)
    bz = z + H * .30
    box("bau_band_l", (W + .008, .010, .06), (x, y - D / 2 - .003, bz), m["orange"], bev=.003)
    box("bau_band_r", (W + .008, .010, .06), (x, y + D / 2 + .003, bz), m["orange"], bev=.003)
    box("bau_band_b", (.010, D + .008, .06), (x - W / 2 - .003, y, bz), m["orange"], bev=.003)
    for k in range(8):
        box(f"bau_refl_b{k}", (.008, .05, .03), (x - W / 2 - .002, y - .20 + k * .056, z + .06), m["refl"] if k % 2 else m["white"], bev=.002)
        box(f"bau_refl_lid{k}", (.008, .05, .018), (x - W / 2 - .012, y - .20 + k * .056, z + H + .035), m["refl"] if k % 2 else m["white"], bev=.002)
    for s in (-1, 1):
        for k in range(8):
            box(f"bau_refl_s{s}{k}", (.05, .008, .03), (x - .20 + k * .056, y + s * (D / 2 + .002), z + .06), m["refl"] if k % 2 else m["white"], bev=.002)
        for k in range(6): cyl(f"bau_rivet{s}{k}", .004, .004, (x - .20 + k * .08, y + s * (D / 2 + .002), z + .11), m["chrome"], axis='Y', verts=8)
    bag_logo("logo_l", (x, y - D / 2 - .005, z + H * .70), (rad(90), 0, 0), m["white"], size=.14, m_handle=m["orange"])
    bag_logo("logo_r", (x, y + D / 2 + .005, z + H * .70), (rad(-90), 0, 0), m["white"], size=.14, m_handle=m["orange"])
    bag_logo("logo_b", (x - W / 2 - .005, y, z + H * .70), (rad(90), 0, rad(-90)), m["white"], size=.13, m_handle=m["orange"])
    text("bau_txt_l", "DELIVERY", .036, (x, y - D / 2 - .006, z + H * .47), m["white"], rot=(rad(90), 0, 0), extrude=.0015)
    text("bau_txt_r", "DELIVERY", .036, (x, y + D / 2 + .006, z + H * .47), m["white"], rot=(rad(90), 0, rad(180)), extrude=.0015)
    text("bau_txt_l2", "supermercado", .016, (x, y - D / 2 - .006, z + H * .40), m["white"], rot=(rad(90), 0, 0), extrude=.001, bold=False)
    text("bau_txt_b", "CHECKOUT", .030, (x - W / 2 - .006, y, z + H * .47), m["white"], rot=(rad(90), 0, rad(-90)), extrude=.0015)
    text("bau_txt_b2", "supermercado", .014, (x - W / 2 - .006, y, z + H * .40), m["white"], rot=(rad(90), 0, rad(-90)), extrude=.001, bold=False)
    qr_sticker("bau_qr", (x + .14, y - D / 2 - .005, z + H * .20), (rad(90), 0, 0), m["white"], m["qr"], size=.05)
    box("bau_sticker", (.07, .004, .025), (x - .12, y + D / 2 + .004, z + H * .22), m["white"], bev=.003)
    text("bau_sticker_t", "FRÁGIL", .012, (x - .12, y + D / 2 + .007, z + H * .22), m["refl"], rot=(rad(90), 0, rad(180)), extrude=.0005)
    for k in range(4): cyl(f"bau_bolt{k}", .008, .01, (x - .16 + (k % 2) * .32, y - .16 + (k // 2) * .32, z - .005), m["steel"], verts=8)

# ---------------------------------------------------------------- rider
def hand(nm, grip_center, s, m):
    """Gloved hand closed around the grip (grip axis = Y). grip_center is a point on that axis; s = side (-1/+1)."""
    gc = Vector(grip_center)
    rbox(f"{nm}_palm", (.075, .085, .05), gc + Vector((-.012, 0, .040)), m["glove"], rot=(0, rad(-20), 0), seg=5, ss=3)
    for k in range(4):
        yy = gc.y + s * (-.03 + k * .02)
        curve_tube(f"{nm}_finger{k}", arc_pts((gc.x, yy, gc.z), .030, 100, -70, 12, plane='XZ'), .0095 - k * .0006, m["glove"], res=12)
        sphere(f"{nm}_knuckle{k}", .0075, (gc.x + .030 * math.cos(rad(95)), yy, gc.z + .030 * math.sin(rad(95)) + .004), m["glove"], seg=12)
    curve_tube(f"{nm}_thumb", arc_pts((gc.x, gc.y - s * .045, gc.z), .028, 170, 300, 10, plane='XZ'), .0095, m["glove"], res=12)
    rbox(f"{nm}_cuff", (.07, .075, .045), gc + Vector((-.06, 0, .072)), m["glove"], rot=(0, rad(-35), 0), seg=5, ss=3)
    box(f"{nm}_strap", (.012, .08, .02), gc + Vector((-.07, 0, .087)), m["orange"], bev=.004, rot=(0, rad(-35), 0))
    rbox(f"{nm}_kpad", (.045, .06, .012), gc + Vector((-.018, 0, .066)), m["glove"], rot=(0, rad(-20), 0), seg=4, ss=2)
    stitches(f"{nm}_st", [(gc.x - .045, gc.y - s * .035, gc.z + .058), (gc.x - .045, gc.y + s * .035, gc.z + .058)], m["thread"], step=.008, r=.0009, length=.004)

def build_rider():
    m = M()
    hip = Vector((-0.34, 0, 0.86)); sh = Vector((-0.16, 0, 1.30))
    lean = (0, math.atan2((sh - hip).x, (sh - hip).z), 0); LN = Matrix.Rotation(lean[1], 4, 'Y')
    def L(dx, dy, dz): return (hip + sh) / 2 + LN @ Vector((dx, dy, dz))
    # --- torso + arms: one skin mesh (jacket)
    chest = (hip + sh) / 2 + Vector((.02, 0, .06)); belly = hip + Vector((.0, 0, .14)); neck = sh + Vector((.02, 0, .03))
    nodes = [(belly, (.105, .15)), (chest, (.105, .165)), (sh + Vector((0, 0, -.01)), (.09, .165)), (neck, (.055, .06)), (neck + Vector((.02, 0, .06)), (.05, .05))]
    edges = [(0, 1), (1, 2), (2, 3), (3, 4)]
    for s in (-1, 1):
        a0 = sh + Vector((0, s * .18, -.01)); a1 = Vector((0.06, s * .27, 1.12)); gc = Vector((0.32, s * .32, 0.985)); a2 = gc + Vector((-.07, 0, .085))
        mid_u = (a0 + a1) / 2; mid_f = (a1 + a2) / 2
        base = len(nodes)
        nodes += [(a0, (.068, .068)), (mid_u, (.055, .052)), (a1, (.05, .05)), (mid_f, (.046, .044)), (a2 - (a2 - a1).normalized() * .02, (.040, .038))]
        edges += [(2, base), (base, base + 1), (base + 1, base + 2), (base + 2, base + 3), (base + 3, base + 4)]
    skin_obj("jacket_body", nodes, edges, m["jacket"], ss=3)
    # --- pelvis + legs: one skin mesh (jeans)
    nodes = [(hip + Vector((0, 0, .04)), (.12, .165)), (hip + Vector((-.03, 0, -.06)), (.11, .15))]; edges = [(0, 1)]
    for s in (-1, 1):
        l0 = hip + Vector((-.01, s * .105, -.04)); l1 = Vector((0.04, s * .19, 0.74)); l2 = Vector((-0.08, s * .20, 0.40))
        base = len(nodes)
        nodes += [(l0, (.085, .08)), ((l0 + l1) / 2, (.075, .07)), (l1, (.065, .065)), ((l1 + l2) / 2, (.058, .056)), (l2 + Vector((0, 0, .03)), (.048, .046))]
        edges += [(1, base), (base, base + 1), (base + 1, base + 2), (base + 2, base + 3), (base + 3, base + 4)]
    skin_obj("jeans_body", nodes, edges, m["pants"], ss=3)
    # --- clothing details on top of the skin meshes
    box("belt", (.245, .33, .03), hip + Vector((.02, 0, .10)), m["glove"], bev=.01, seg=4, ss=2, rot=lean)
    box("buckle", (.02, .04, .03), hip + Vector((.145, 0, .095)), m["chrome"], bev=.005)
    box("jacket_hem", (.26, .36, .035), L(.0, 0, -.235), m["jacket_d"], bev=.012, seg=4, ss=2, rot=lean)
    box("zipper", (.012, .016, .42), L(.138, 0, .02), m["zipper"], bev=.003, rot=lean)
    for k in range(26): box(f"zip_tooth{k}", (.006, .006, .006), L(.144, (-1) ** k * .004, -.18 + k * .016), m["zipper"], bev=0, rot=lean)
    box("zipper_tab", (.012, .018, .025), L(.142, 0, .23), m["chrome"], bev=.004, rot=lean)
    curve_tube("zip_pull", [L(.15, 0, .23), L(.17, 0, .20), L(.16, 0, .17)], .003, m["chrome"])
    box("collar_a", (.06, .10, .035), L(.04, -.06, .255), m["jacket_d"], bev=.012, seg=4, ss=2, rot=(lean[0], lean[1], rad(30)))
    box("collar_b", (.06, .10, .035), L(.04, .06, .255), m["jacket_d"], bev=.012, seg=4, ss=2, rot=(lean[0], lean[1], rad(-30)))
    torus("collar_ring", .064, .016, sh + Vector((.01, 0, .025)), m["jacket_d"], rot=lean, segs=(48, 12))
    for s in (-1, 1):
        box(f"pocket{s}", (.014, .10, .11), L(.135, s * .11, -.10), m["jacket_d"], bev=.004, seg=3, ss=2, rot=lean)
        box(f"pocket_flap{s}", (.016, .10, .03), L(.139, s * .11, -.045), m["jacket_d"], bev=.004, seg=3, ss=1, rot=lean)
        cyl(f"pocket_snap{s}", .006, .003, L(.148, s * .11, -.05), m["chrome"], rot=(0, rad(90), 0), verts=12)
        stitches(f"pocket_st{s}", [L(.145, s * .06, -.05), L(.145, s * .06, -.155), L(.145, s * .16, -.155), L(.145, s * .16, -.05)], m["thread"], step=.009, r=.0009, length=.0045)
        box(f"chest_stripe{s}", (.012, .09, .03), L(.136, s * .11, .10), m["stripe"], bev=.003, rot=lean)
        box(f"chest_stripe2{s}", (.012, .09, .008), L(.136, s * .11, .13), m["orange"], bev=.002, rot=lean)
        rbox(f"shoulder_pad{s}", (.10, .09, .05), sh + Vector((0, s * .20, .03)), m["jacket_d"], seg=4, ss=2, rot=(0, 0, rad(-15) * s))
        stitches(f"shoulder_st{s}", [sh + Vector((-.05, s * .17, .06)), sh + Vector((.0, s * .22, .06)), sh + Vector((.05, s * .17, .06))], m["thread"], step=.009, r=.0009, length=.0045)
    bnd = torus("band", .165, .03, L(.0, 0, .10), m["orange"], rot=lean, segs=(64, 16)); bnd.scale = (.72, 1, .85)
    bnd2 = torus("band_refl", .168, .008, L(.0, 0, .10), m["stripe"], rot=lean, segs=(64, 10)); bnd2.scale = (.72, 1, 1)
    box("band_back", (.03, .26, .12), L(-.138, 0, .12), m["white"], bev=.01, seg=4, ss=2, rot=lean)
    text("back_txt", "DELIVERY", .030, L(-.156, 0, .12), m["ink"], rot=(rad(90), lean[1], rad(-90)), extrude=.001)
    bag_logo("back_logo", L(-.156, 0, -.02), (rad(90), lean[1], rad(-90)), m["white"], size=.11, m_handle=m["orange"])
    tube("neck", sh + Vector((.0, 0, -.02)), sh + Vector((.03, 0, .10)), .045, m["skin"], cap=False, ss=2)
    # --- helmet (full face): shell + chin bar + visor shell + seams, vents, spoiler, decals, strap
    hc = sh + Vector((.05, 0, .20))
    sphere("helmet", .125, hc, m["helmet"], scale=(1.05, .98, 1.08), seg=64, ss=2)
    sphere("chin", .11, hc + Vector((.03, 0, -.055)), m["helmet"], scale=(.98, .92, .62), seg=48, ss=2)
    sphere("visor", .124, hc + Vector((.025, 0, .015)), m["visor"], scale=(.96, .95, .42), seg=48, ss=2)
    torus("visor_seam", .106, .004, hc + Vector((.08, 0, .02)), m["black"], rot=(0, rad(90), 0), segs=(64, 10))
    for s in (-1, 1):
        cyl(f"visor_pivot{s}", .018, .008, hc + Vector((.0, s * .128, .02)), m["black"], axis='Y', verts=24, bev=.002)
        cyl(f"visor_pivot{s}b", .008, .004, hc + Vector((.0, s * .134, .02)), m["chrome"], axis='Y', verts=12)
        rbox(f"vent_side{s}", (.045, .014, .032), hc + Vector((.06, s * .117, .07)), m["black"], seg=3, ss=1)
        for k in range(3): box(f"vent_side_slot{s}{k}", (.004, .006, .024), hc + Vector((.05 + k * .012, s * .124, .07)), m["gun_d"], bev=.001)
        rbox(f"ear_pad{s}", (.08, .012, .06), hc + Vector((-.01, s * .128, -.03)), m["helmet"], seg=3, ss=1)
    rbox("vent_top", (.075, .045, .02), hc + Vector((-.02, 0, .132)), m["black"], seg=3, ss=2)
    for k in range(3): box(f"vent_top_slot{k}", (.05, .006, .006), hc + Vector((-.02, -.012 + k * .012, .141)), m["gun_d"], bev=.001)
    rbox("spoiler", (.05, .11, .018), hc + Vector((-.125, 0, .02)), m["helmet"], seg=4, ss=2, rot=(0, rad(-20), 0))
    rbox("helmet_stripe", (.10, .03, .006), hc + Vector((-.122, 0, .05)), m["orange"], seg=3, ss=1, rot=(0, rad(70), 0))
    rbox("helmet_stripe2", (.10, .012, .005), hc + Vector((-.118, .028, .06)), m["white"], seg=3, ss=1, rot=(0, rad(70), 0))
    rbox("chin_vent", (.012, .06, .025), hc + Vector((.138, 0, -.07)), m["black"], seg=3, ss=1)
    for k in range(4): box(f"chin_slot{k}", (.004, .006, .018), hc + Vector((.144, -.018 + k * .012, -.07)), m["gun_d"], bev=.001)
    bag_logo("helmet_logo", hc + Vector((-.03, -.128, .0)), (rad(90), rad(-10), rad(180)), m["white"], size=.05, m_handle=m["orange"])
    curve_tube("chin_strap", [hc + Vector((.0, -.10, -.09)), hc + Vector((.02, -.06, -.13)), hc + Vector((.02, .06, -.13)), hc + Vector((.0, .10, -.09))], .005, m["glove"])
    torus("d_ring", .010, .002, hc + Vector((.02, -.05, -.135)), m["chrome"], rot=(0, rad(90), 0), segs=(16, 6))
    # --- arms details (stripes, cuffs, hands)
    for s in (-1, 1):
        a0 = sh + Vector((0, s * .19, -.02)); a1 = Vector((0.06, s * .27, 1.12)); gc = Vector((0.32, s * .32, 0.985)); a2 = gc + Vector((-.07, 0, .085))
        rt = (a2 - a1).to_track_quat('Z', 'Y').to_euler(); ru = (a1 - a0).to_track_quat('Z', 'Y').to_euler()
        torus(f"sleeve_stripe{s}", .048, .006, a1 + (a2 - a1) * .45, m["stripe"], rot=rt, segs=(40, 10))
        torus(f"sleeve_stripe{s}b", .047, .004, a1 + (a2 - a1) * .55, m["orange"], rot=rt, segs=(40, 10))
        torus(f"cuff{s}", .044, .009, a1 + (a2 - a1) * .93, m["jacket_d"], rot=rt, segs=(40, 10))
        rbox(f"elbow_pad{s}", (.08, .06, .03), a1 + Vector((.02, s * .035, .0)), m["jacket_d"], seg=4, ss=2, rot=rt)
        for k in range(3):   # fabric folds at the inner elbow
            torus(f"fold{s}{k}", .052 - k * .003, .003, a1 + (a1 - a0).normalized() * (.03 + k * .018) * -1, m["jacket"], rot=ru, segs=(32, 8))
        stitches(f"sleeve_st{s}", [a0 + (a1 - a0) * .15 + Vector((0, s * .07, 0)), a1 + Vector((0, s * .052, 0)), a2 + Vector((0, s * .045, 0))], m["thread"], step=.01, r=.0009, length=.005)
        hand(f"hand{s}", gc, s, m)
    # --- legs details (seams, knee pads, cuffs, sneakers)
    for s in (-1, 1):
        l0 = hip + Vector((-.02, s * .12, -.02)); l1 = Vector((0.04, s * .19, 0.74)); l2 = Vector((-0.08, s * .20, 0.40))
        rl = (l2 - l1).to_track_quat('Z', 'Y').to_euler()
        for i, (p0, p1, r) in enumerate(((l0, l1, .082), (l1, l2, .062))):
            side = Vector((0, s, 0)) * (r + .001)
            stitches(f"seam{s}_{i}", [p0 + side, (p0 + p1) * .5 + side, p1 + side], m["thread"], step=.011, r=.001, length=.0055)
            off = Vector((.012, 0, 0))
            stitches(f"seam{s}_{i}b", [p0 + side + off, (p0 + p1) * .5 + side + off, p1 + side + off], m["thread"], step=.011, r=.001, length=.0055)
        rbox(f"knee_pad{s}", (.09, .07, .05), l1 + Vector((.045, s * .0, .0)), m["pants"], seg=4, ss=2, rot=rl)
        torus(f"knee_fold{s}", .066, .004, l1 + Vector((-.01, 0, .06)), m["pants"], rot=rl, segs=(40, 8))
        torus(f"jean_cuff{s}", .050, .010, l2 + Vector((0, 0, .04)), m["pants"], rot=rl, segs=(40, 10))
        box(f"back_pocket{s}", (.02, .09, .10), hip + Vector((-.15, s * .09, -.02)), m["pants"], bev=.005, seg=3, ss=1, rot=(0, rad(10), 0))
        foot = l2 + Vector((.05, 0, -.045))
        rbox(f"sneaker{s}", (.27, .10, .09), foot, m["sneaker"], seg=6, ss=3)
        rbox(f"sole{s}", (.28, .105, .025), foot + Vector((0, 0, -.045)), m["sole"], seg=5, ss=2)
        for k in range(7): box(f"sole_tread{s}{k}", (.016, .10, .004), foot + Vector((-.12 + k * .04, 0, -.059)), m["sole"], bev=.001)
        rbox(f"toecap{s}", (.09, .105, .05), foot + Vector((.10, 0, -.025)), m["sole"], seg=5, ss=2)
        rbox(f"tongue{s}", (.07, .05, .025), foot + Vector((.0, 0, .045)), m["sneaker"], seg=4, ss=2, rot=(0, rad(-15), 0))
        rbox(f"heel_tab{s}", (.03, .06, .06), foot + Vector((-.13, 0, .02)), m["jacket_d"], seg=4, ss=2)
        for k in range(4):
            z = .040 + k * .004; xx = -.03 + k * .025
            curve_tube(f"lace{s}{k}", [foot + Vector((xx, -.028, z)), foot + Vector((xx + .012, 0, z + .012)), foot + Vector((xx + .025, .028, z))], .0025, m["jacket_d"], res=8)
            for sy in (-1, 1): cyl(f"eyelet{s}{k}{sy}", .004, .003, foot + Vector((xx + (sy > 0) * .025, sy * .03, z)), m["chrome"], verts=10)
        box(f"shoe_stripe{s}", (.12, .004, .02), foot + Vector((-.02, s * .052, .0)), m["orange"], bev=.002)
        stitches(f"shoe_st{s}", [foot + Vector((.13, s * .054, -.02)), foot + Vector((0, s * .056, -.02)), foot + Vector((-.13, s * .054, -.02))], m["thread"], step=.01, r=.0009, length=.005)

# ---------------------------------------------------------------- assembly / cameras / lights / render
def build(parked=False, name="Moto_Root", loc=(0, 0, 0), yaw=0.):
    global ROOT
    bpy.ops.object.empty_add(location=loc); ROOT = bpy.context.object; ROOT.name = name; ROOT.rotation_euler = (0, 0, yaw)
    build_bike(parked=parked)
    if not parked: build_rider()
    root = ROOT; ROOT = None
    return root

def face_count(root=None):
    """Evaluated (render-level) polygon count of everything under `root` (or the whole scene)."""
    dg = bpy.context.evaluated_depsgraph_get(); n = 0
    for o in bpy.context.scene.objects:
        if root is not None and not (o.parent == root or (o.parent and o.parent.parent == root)): continue
        if o.type in ('MESH', 'CURVE', 'FONT'):
            try:
                ev = o.evaluated_get(dg); me = ev.to_mesh(); f = len(me.polygons); ev.to_mesh_clear()
                for md in o.modifiers:   # subsurf is evaluated at viewport level 0 -> scale to the render level
                    if md.type == 'SUBSURF': f *= 4 ** (md.render_levels - md.levels)
                n += f
            except Exception: pass
    return n

def world_sky(top=(.10, .40, .95, 1), horizon=(.60, .80, 1.0, 1), strength=.55, name="DB_World"):
    """Vivid stylised sky: vertical gradient in camera window space (always behind the subject); low strength so the
    warm key/sun dominate and colours stay saturated."""
    sc = bpy.context.scene
    w = bpy.data.worlds.get(name) or bpy.data.worlds.new(name); sc.world = w; w.use_nodes = True; nt = w.node_tree
    for n in list(nt.nodes): nt.nodes.remove(n)
    out = nt.nodes.new("ShaderNodeOutputWorld"); bg = nt.nodes.new("ShaderNodeBackground"); nt.links.new(bg.outputs[0], out.inputs[0])
    tc = nt.nodes.new("ShaderNodeTexCoord"); sep = nt.nodes.new("ShaderNodeSeparateXYZ"); nt.links.new(tc.outputs["Window"], sep.inputs[0])
    rp = nt.nodes.new("ShaderNodeValToRGB"); rp.color_ramp.elements[0].position = .0; rp.color_ramp.elements[0].color = horizon
    rp.color_ramp.elements[1].position = .80; rp.color_ramp.elements[1].color = top
    nt.links.new(sep.outputs["Y"], rp.inputs["Fac"]); nt.links.new(rp.outputs["Color"], bg.inputs["Color"]); bg.inputs["Strength"].default_value = strength
    return w

def lights(target=(0, 0, .8), size=2.4, sun=3.0):
    sc = bpy.context.scene
    world_sky()
    t = Vector(target)
    def area(n, loc, energy, s, color=(1, .96, .90)):
        bpy.ops.object.light_add(type='AREA', location=loc); l = bpy.context.object; l.name = n
        l.data.energy = energy; l.data.size = s; l.data.color = color
        l.rotation_euler = (t - Vector(loc)).to_track_quat('-Z', 'Y').to_euler()
    area("Key", (t.x + size * 1.4, t.y - size * 1.8, t.z + size * 2.2), 1800 * (size / 2.4) ** 2, size * 1.6, (1, .94, .84))
    area("Fill", (t.x - size * 1.6, t.y - size * 1.4, t.z + size * .8), 350 * (size / 2.4) ** 2, size * 2.2, (.88, .94, 1))
    area("Rim", (t.x - size * .8, t.y + size * 2.0, t.z + size * 1.6), 600 * (size / 2.4) ** 2, size * 1.2, (1, .98, .95))
    bpy.ops.object.light_add(type='SUN', location=(0, 0, 10)); s = bpy.context.object; s.name = "Sun"
    s.data.energy = sun * 1.5; s.data.angle = rad(5); s.data.color = (1, .95, .85); s.rotation_euler = (rad(42), rad(14), rad(-30))

def camera(target, pitch_deg, yaw_deg, dist, lens=50, ortho=None):
    sc = bpy.context.scene
    cam = bpy.data.objects.get("DB_Cam")
    if not cam:
        cam = bpy.data.objects.new("DB_Cam", bpy.data.cameras.new("DB_Cam")); sc.collection.objects.link(cam)
    cam.data.lens = lens; cam.data.sensor_width = 36; cam.data.clip_end = 300
    cam.data.type = 'ORTHO' if ortho else 'PERSP'
    if ortho: cam.data.ortho_scale = ortho
    p, y = rad(pitch_deg), rad(yaw_deg); t = Vector(target)
    cam.location = t + Vector((math.sin(y) * math.cos(p) * dist, -math.cos(y) * math.cos(p) * dist, math.sin(p) * dist))
    cam.rotation_euler = (t - cam.location).to_track_quat('-Z', 'Y').to_euler()
    sc.camera = cam; return cam

def studio_floor(r=30.):
    """Cream paver floor (large bevelled slabs with grout) fading into the gradient sky."""
    slab = mat("studio_floor", (0.96, 0.88, 0.66, 1), "plaster", rough=.8, bump=.25, scale=2, dirt=.08, wear=.15, tint=(0.86, 0.74, 0.50, 1))
    grout = mat("studio_grout", (0.74, 0.64, 0.46, 1), "plaster", rough=.95, bump=.2, scale=4, rand=0)
    bpy.ops.mesh.primitive_plane_add(size=r * 2, location=(0, 0, -.015)); o = bpy.context.object; _finish(o, "floor", slab)
    s = .6; n = 9
    box("grout", (s * (2 * n + 1), s * (2 * n + 1), .004), (0, 0, -.012), grout, bev=0)
    for i in range(-n, n + 1):
        for j in range(-n, n + 1):
            box(f"slab{i}_{j}", (s - .012, s - .012, .02), (i * s, j * s, -.01), slab, bev=.004, seg=2)

def street_tile():
    m = M()
    road = mat("road", (0.20, 0.21, 0.18, 1), "rubber", rough=.95, bump=.5, scale=3); edge = mat("edge", (0.52, 0.50, 0.33, 1), "kraft", rough=.9, bump=.3, scale=2)
    stripe = mat("stripe_rd", (0.92, 0.90, 0.80, 1), "plastic", rough=.8, bump=.2, wear=.6, scale=4); grass = mat("grass", (0.23, 0.48, 0.07, 1), "rubber", rough=.95, bump=.6, scale=4)
    wall = mat("wall", CREAM, "plaster", rough=.85, bump=.2, scale=3); paver = mat("paver", (0.62, 0.58, 0.42, 1), "plaster", rough=.9, bump=.3, scale=3, dirt=.2, wear=.1)
    box("asphalt", (16, 7, .06), (0, -1.5, -.03), road, bev=0)
    for s in (-1, 1): box(f"curb{s}", (16, .25, .14), (0, -1.5 + s * 3.6, .0), edge, bev=.03)
    for i in range(-13, 14):
        for j in range(5): box(f"pv{i}_{j}", (.58, .58, .12), (i * .6, 2.4 + j * .6, .0), paver, bev=.012, seg=2)
    for k in range(4): box(f"xw{k}", (.5, 6.4, .004), (5.4 + k * .9, -1.5, .032), stripe, bev=0)
    for k in range(8): box(f"dash{k}", (.9, .12, .004), (-7.2 + k * 1.6, -1.5, .032), stripe, bev=0)
    box("facade", (10, 1.2, 4.2), (-1, 5.7, 2.1), wall, bev=.04)
    for k in range(3): box(f"fac_win{k}", (.9, .05, 1.1), (-4 + k * 1.5, 5.08, 2.2), mat("glass2", (0.6, 0.8, 0.85, 1), "plastic", rough=.1, metal=.2, bump=0), bev=.01)
    for k in range(3): box(f"fac_sill{k}", (1.0, .12, .06), (-4 + k * 1.5, 5.06, 1.62), m["white"], bev=.01)
    box("awning", (6, 1.3, .08), (-1, 4.6, 2.6), m["blue"], bev=.03)
    for k in range(13): box(f"awn_scallop{k}", (.44, .06, .12), (-3.9 + k * .48, 3.96, 2.52), m["blue"] if k % 2 else m["white"], bev=.01)
    box("door", (1.6, .05, 2.3), (-1, 5.08, 1.15), mat("glass2", (0.6, 0.8, 0.85, 1), "plastic", rough=.1, metal=.2, bump=0), bev=.01)
    box("fac_sign", (3.0, .08, .5), (-1, 5.06, 3.4), m["white"], bev=.01)
    text("fac_txt", "CHECKOUT", .3, (-1, 5.0, 3.4), m["blue"], rot=(rad(90), 0, 0), extrude=.01)
    cyl("lamp", .06, 4.5, (3.5, 3.2, 2.25), m["gun"], verts=16)
    sphere("lamp_head", .22, (3.5, 3.2, 4.6), m["white"], seg=24)
    box("grass", (2.5, 2.4, .10), (6.2, 3.7, .06), grass, bev=.02)
    cyl("tree", .08, 1.8, (6.2, 3.7, .9), mat("bark", (0.35, 0.22, 0.12, 1), "wood", rough=.9, bump=.6, scale=10), verts=14)
    for k, (dx, dy, dz, r) in enumerate(((0, 0, 2.4, .8), (.5, .2, 2.2, .5), (-.4, -.3, 2.1, .45))): sphere(f"leaf{k}", r, (6.2 + dx, 3.7 + dy, dz), mat("leaf", (0.33, 0.58, 0.20, 1), "leather", rough=.9, bump=.6, scale=5), seg=28, ss=1)

def _render(fn, res=(1600, 1200), transparent=False):
    sc = bpy.context.scene; os.makedirs(OUT, exist_ok=True)
    sc.render.resolution_x, sc.render.resolution_y = res; sc.render.film_transparent = transparent
    p = os.path.join(OUT, fn); sc.render.filepath = p; bpy.ops.render.render(write_still=True); return p

def render_hero():
    clear(); studio_floor(); build(); lights()
    camera((-0.05, 0, 0.78), 18, 42, 5.6, lens=60); return _render("bike_hero.png")

def render_side():
    clear(); studio_floor(); build(); lights()
    camera((-0.12, 0, 0.80), 4, 0, 7.0, lens=70); return _render("bike_side.png", (1800, 1100))

def render_parked():
    clear(); studio_floor(); build(parked=True, name="Moto_Parked"); lights()
    camera((-0.15, 0, 0.62), 20, -48, 5.2, lens=60); return _render("bike_parked.png")

def render_detail():
    """Close-up of the engine + front wheel (right side: disc brake, carb, exhaust) to show modelling + materials."""
    clear(); studio_floor(); build(parked=True, name="Moto_Parked"); lights(target=(0.35, 0, .5), size=1.6)
    camera((0.33, 0, 0.50), 14, 118, 1.9, lens=60); return _render("bike_detail.png", (1600, 1100))

def render_iso():
    clear(); street_tile()
    build(name="Moto_Riding", loc=(0.5, -0.6, 0.0), yaw=rad(0))
    build(parked=True, name="Moto_Parked", loc=(-3.2, 1.6, 0.0), yaw=rad(-90))
    lights(target=(0, 0, 0), size=8, sun=4.0)
    world_sky(top=(.40, .70, 1.0, 1), horizon=(.75, .88, 1.0, 1), strength=1.0)
    camera((0.2, 0.4, 0.6), 35, 36.4, 40, ortho=15.0); return _render("bike_iso.png", (1600, 1000))

def render_all():
    return [render_hero(), render_side(), render_parked(), render_detail(), render_iso()]
